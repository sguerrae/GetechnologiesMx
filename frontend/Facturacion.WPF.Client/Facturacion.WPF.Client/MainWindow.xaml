<Window x:Class="Facturacion.WPF.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Facturacion.WPF.Client"
        mc:Ignorable="d"
        Title="Facturación Cliente" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="300">
            <Button Content="Mostrar" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Mostrar_Click" />
            <ListBox x:Name="PersonasList" Height="350" MouseDoubleClick="PersonasList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Nombre}"/> 
                            <Run Text=" "/>
                            <Run Text="{Binding ApellidoPaterno}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Identificacion}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <TextBlock Text="Registrar Persona" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Nombre" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <TextBlock Foreground="Red" FontSize="11" Text="{Binding [Nombre]}" />

            <TextBlock Text="Apellido Paterno" Margin="0,8,0,0" />
            <TextBox Text="{Binding ApellidoPaterno, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <TextBlock Foreground="Red" FontSize="11" Text="{Binding [ApellidoPaterno]}" />

            <TextBlock Text="Apellido Materno (opcional)" Margin="0,8,0,0" />
            <TextBox Text="{Binding ApellidoMaterno, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Identificación" Margin="0,8,0,0" />
            <TextBox Text="{Binding Identificacion, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <TextBlock Foreground="Red" FontSize="11" Text="{Binding [Identificacion]}" />

            <Button Content="Enviar Guardar" Width="100" Margin="0,12,0,0" HorizontalAlignment="Left" Click="Enviar_Click" />
        </StackPanel>
    </Grid>
</Window>
